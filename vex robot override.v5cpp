{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n\n\n#include \"vex.h\"\n\n\nusing namespace vex;\n\n\n\n\n\nmotor MotorL1 = motor(PORT1);\nmotor MotorR1 = motor(PORT3);\nmotor MotorL2 = motor(PORT2);\nmotor MotorR2 = motor(PORT4);\n\nmotor_group MotorLeft(MotorL1, MotorL2);\nmotor_group MotorRight(MotorR1, MotorR2);\n\n\n\nmotor ArmMotor1 = motor(PORT7);\nmotor ArmMotor2 = motor(PORT8);\nmotor_group ArmMotor(ArmMotor1, ArmMotor2)\n\nmotor IntakeMotor = motor(PORT6);\n\ncontroller Controller1;\ninertial Inertial = inertial(PORT11);\n\nint leftMotorValue = 0;\nint rightMotorValue = 0;\ndouble speedValue = 1;\ndouble armCurrentPos = 0;\n\nvoid driveAxisChanged()\n{\n  leftMotorValue = (Controller1.Axis1.position()* ((1.5 - speedValue)* -1)) - Controller1.Axis2.position();\n  rightMotorValue = (Controller1.Axis1.position()* ((1.5 - speedValue) * -1)) + Controller1.Axis2.position();\n\n\n  if (leftMotorValue > 100)\n    {\n      leftMotorValue = 100;\n    }\n    else if (leftMotorValue < -100) \n    {\n      leftMotorValue = -100;\n    }\n\n      if (rightMotorValue > 100)\n    {\n      rightMotorValue = 100;\n    }\n    else if (rightMotorValue < -100)\n    {\n      rightMotorValue = -100;\n    }\n\n    MotorLeft.setVelocity(leftMotorValue * speedValue, percent);\n    MotorRight.setVelocity(rightMotorValue * speedValue, percent);\n    \n}\n\nvoid intakeIn()\n{\n  IntakeMotor.spin(forward);\n}\n\nvoid intakeOut()\n{\n  IntakeMotor.spin(reverse);\n}\n\nvoid leftButtonPressed() \n{\n  \n  Controller1.Screen.clearScreen();\n  Controller1.Screen.setCursor(1,1);\n  if (speedValue == 1)\n  {\n    speedValue = 0.3;\n    Controller1.Screen.print(\"Slow Mode\");\n  }\n  else\n  {\n    speedValue = 1;\n    Controller1.Screen.print(\"Fast Mode\");\n  }\n\n  \n    \n}\n\n\n\n\n\nvoid preAutonomous(void) {\n  // actions to do when the program starts\n  Brain.Screen.clearScreen();\n  Brain.Screen.print(\"pre auton code\");\n  ArmMotor.setStopping(hold);\n  ArmMotor.setPosition(0,degrees);\n  \n  wait(1, seconds);\n}\n\nvoid autonomous(void) {\n  Brain.Screen.clearScreen();\n  Brain.Screen.print(\"autonomous code\");\n  // place automonous code here\n}\n\nvoid userControl(void) {\n  Brain.Screen.clearScreen();\n  Controller1.Screen.print(\"Fast Mode\");\n\n  Inertial.calibrate();\n  wait(1, seconds);\n\n  Controller1.Axis2.changed(driveAxisChanged);\n  Controller1.Axis1.changed(driveAxisChanged);\n\n\n  Controller1.ButtonR2.pressed(intakeIn);\n  Controller1.ButtonR1.pressed(intakeOut);\n\n  Controller1.ButtonLeft.pressed(leftButtonPressed);\n\n  MotorLeft.setVelocity(0, percent);\n  MotorRight.setVelocity(0, percent);\n\n  MotorLeft.spin(reverse);\n  MotorRight.spin(reverse);\n\n\n  \n  while (true) {\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.clearLine(1);\n    Brain.Screen.print(leftMotorValue);\n\n    Brain.Screen.setCursor(2,1);\n    Brain.Screen.clearLine(2);\n    Brain.Screen.print(rightMotorValue);\n    \n    Brain.Screen.setCursor(3,1);\n    Brain.Screen.clearLine(3);\n    Brain.Screen.print(armCurrentPos);\n\n    \n\n\n\n\n    if (!Controller1.ButtonR1.pressing() && !Controller1.ButtonR2.pressing())\n    {\n      IntakeMotor.stop();\n    }\n\n    armCurrentPos = ArmMotor.position(degrees);\n\n    if (Controller1.Axis3.position() > 0)\n    {\n      if (armCurrentPos > 100)\n    {\n      ArmMotor.stop();\n    }\n    else\n    {\n      ArmMotor.spin(forward, Controller1.Axis3.position(), percent);\n    }\n    }\n    else if (Controller1.Axis3.position() < 0)\n    {\n      if (armCurrentPos < 1)\n    {\n      ArmMotor.stop();\n    }\n    else\n    {\n      ArmMotor.spin(forward, Controller1.Axis3.position(), percent);\n    }\n    }\n\n    wait(20, msec);\n  }\n}\n\n\n\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // create competition instance\n  competition Competition;\n\n  // Set up callbacks for autonomous and driver control periods.\n  \n  /*\n  Competition.autonomous(autonomous);\n  Competition.drivercontrol(userControl);\n  */\n  // Run the pre-autonomous function.\n\n  preAutonomous();\n\n  userControl();\n\n  // Prevent main from exiting with an infinite loop.\n  while (true) {\n    wait(100, msec);\n  }\n}","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}